# ============================================================
# OMR Test Bot — Environment Variables
# Nusxa oling: cp .env.example .env
# Keyin BARCHA `CHANGE_ME_...` qiymatlarni almashtiring.
#
# DIQQAT: bu fayl git'da turadi va uni repo ko'rgan har kim o'qiydi.
# Bu yerga HECH QACHON haqiqiy token/parol/kalit yozmang — faqat
# namunaviy qiymatlar. Haqiqiy qiymatlar faqat `.env` da (git'ga
# tushmaydi, `.gitignore` da).
# ============================================================

# --- Telegram ---
# @BotFather -> /mybots -> bot -> API Token
BOT_TOKEN=CHANGE_ME_BOTFATHER_TOKEN
# Bot usernameni @ siz kiriting (base.html da ko'rsatiladi)
BOT_USERNAME=Test_Yordamchi_Robot

# Web Dashboard URL — bot ichidan menyuda "Dashboard" tugmasi paydo bo'ladi.
# HTTPS bo'lishi shart (Telegram Web App uchun). Bo'sh qoldirsa tugma ko'rinmaydi.
# Masalan: WEB_APP_URL=https://yourdomain.com/dashboard
WEB_APP_URL=

# --- PostgreSQL ---
# Parol POSTGRES_PASSWORD bilan bir xil bo'lishi SHART (pastga qarang).
# Docker compose ichida host = postgres container nomi.
DATABASE_URL=postgresql+asyncpg://omruser:CHANGE_ME_DB_PAROL@postgres:5432/omrdb
SYNC_DATABASE_URL=postgresql+psycopg2://omruser:CHANGE_ME_DB_PAROL@postgres:5432/omrdb

# --- Redis ---
# Redis PAROL bilan ishga tushadi (docker-compose.yml: --requirepass).
# REDIS_PASSWORD va REDIS_URL ichidagi parol bir xil bo'lishi SHART —
# compose `env_file` ichidagi `${...}` ni kengaytirmaydi, shu sababli
# URL to'liq yozilishi kerak.
# Parolda FAQAT harf va raqam ishlating (masalan `token_hex(32)` natijasi):
# probel, `$`, `@`, `#` compose buyruq qatorida yoki URL'da noto'g'ri
# talqin qilinadi.
REDIS_PASSWORD=CHANGE_ME_REDIS_PAROL
REDIS_URL=redis://:CHANGE_ME_REDIS_PAROL@redis:6379/0

# --- Admin ---
# Vergul bilan ajrating (bo'sh qoldirish mumkin).
# Bu ro'yxatdagi telegram_id birinchi kirishda SUPERADMIN bo'ladi.
ADMIN_TELEGRAM_IDS=

# --- FastAPI internal auth ---
# Bot/worker -> API ichki so'rovlari uchun. Namunaviy qiymat qoldirilsa
# `/attempts/*` endpointlari ataylab 503 qaytaradi (core/security.py).
# Yarating:  python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_API_KEY_32_BELGIDAN_UZUN

# --- Dashboard JWT autentifikatsiya ---
# MAJBURIY: admin panel (/admin) uchun tasodifiy 32+ belgilik kalit.
# Quyidagi namunaviy qiymat qoldirilsa admin panel ATAYLAB ishlamaydi
# (token berilmaydi) — chunki bu kalit ochiq repoda turadi va uni bilgan
# kishi o'ziga SUPERADMIN tokeni yasay oladi. Bot va Mini App bunga
# bog'liq emas, ular ishlashda davom etadi.
#
# Yarating:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-use-a-random-32-char-secret
# JWT cookie muddati (kunlarda)
JWT_EXPIRE_DAYS=7

# --- Fayllar ---
# Docker volume paths (compose'da mount qilinadi)
PDF_OUTPUT_DIR=/data/pdfs
DEBUG_OUTPUT_DIR=/data/debug
# Skan kelganda vaqtincha yoziladigan papka. Baholangandan keyin fayl
# UPLOADS_DIR ga ko'chiriladi; bu yerda qolgan yetimlarni kunlik
# `cleanup_temp_files` (celery beat) o'chiradi.
TEMP_DIR=/tmp/omr_uploads
# Baholangan skanlar (review uchun) — DOIMIY volume.
UPLOADS_DIR=/data/uploads
# TEMP_DIR dagi yetim fayllar shu muddatdan keyin o'chiriladi (soat).
TEMP_FILE_MAX_AGE_HOURS=24

# --- Rasm chegarasi ---
MAX_IMAGE_MB=20
# PDF skandan nechta sahifa tekshiriladi (titul bir varaqli).
OMR_MAX_PAGES=1
# "Alohida" rejimida bir yo'la yuboriladigan titullar chegarasi
# (Telegram flood limiti). Ko'p bo'lsa ZIP tavsiya qilinadi.
TITUL_SINGLE_SEND_MAX=20
# Telegram hujjat chegarasi 50 MB; ZIP shu qiymatda bo'laklarga bo'linadi.
TELEGRAM_ZIP_MAX_MB=45

# --- Vaqt zonasi ---
# "Bugungi skanlar" kabi KUN chegaralari va ko'rsatiladigan vaqt shu
# zonada. Bazada hamma narsa baribir UTC.
APP_TIMEZONE=Asia/Tashkent

# --- API hujjatlari ---
# PROD'da false: /docs butun ichki API sxemasini anonim ko'rsatadi.
# Dev'da true qilib qo'ying.
ENABLE_API_DOCS=false

# --- Telegram Mini App initData muddati ---
# Tutib olingan initData abadiy ishlamasligi uchun (0 = cheksiz, ISHLATMANG).
# Mini App sessiyasi:
INIT_DATA_MAX_AGE_SECONDS=86400
# Admin paneliga kirish (uzoq muddatli refresh beradi — qattiqroq):
ADMIN_INIT_DATA_MAX_AGE_SECONDS=300

# --- OMR sozlamalari ---
# true/false: debug annotatsiya rasmi saqlash
OMR_DEBUG=false
# Doira "to'ldirilgan" deb hisoblanishi uchun minimal fill ratio
FILL_MIN=0.35
# Ikkita eng ko'p to'ldirilgan doira orasidagi minimal farq (ambiguous uchun)
FILL_MARGIN=0.15
# OMR rasterizatsiya DPI (PDF -> image)
OMR_DPI=200
# Warp natijasi o'lchami px (A4 @ ~200 DPI)
WARP_W=1654
WARP_H=2339

# --- Postgres container sozlamalari (docker-compose uchun) ---
# POSTGRES_PASSWORD va DATABASE_URL/SYNC_DATABASE_URL ichidagi parol
# bir xil bo'lishi SHART.
POSTGRES_USER=omruser
POSTGRES_PASSWORD=CHANGE_ME_DB_PAROL
POSTGRES_DB=omrdb

# --- Loki Log Server ---
# Loki konteyneri ishlamasa BO'SH qoldiring — aks holda har log yozuvi
# yuborilmay navbatda to'planadi.
LOKI_URL=http://loki:3100/loki/api/v1/push

# --- Grafana (loglarni ko'rish) ---
# Faqat 127.0.0.1:3001 da ochiladi (SSH tunnel orqali kiring).
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PAROL

# ============================================================
# Docker / deploy
# ============================================================

# API porti qaysi interfeysga bog'lansin. Standart 127.0.0.1 — API
# to'g'ridan-to'g'ri internetga chiqmaydi, oldida nginx/caddy (HTTPS)
# turadi. Reverse proxy YO'Q bo'lsa va portni ochish kerak bo'lsa:
# API_BIND_HOST=0.0.0.0 (tavsiya etilmaydi).
API_BIND_HOST=127.0.0.1

# Image ichiga test bog'liqliklari (pytest va h.k.) o'rnatilsinmi.
# Prod serverda: false. Dev mashinada: true (pytest ishlashi uchun).
INSTALL_DEV=true

# uvicorn `--forwarded-allow-ips`: X-Forwarded-For sarlavhasiga FAQAT
# shu IP'lardan ishoniladi. Docker ichidagi proxy bo'lsa uning tarmoq
# IP'sini yozing.
TRUSTED_PROXY_IPS=127.0.0.1

# ============================================================
# Admin panel (React) — /admin
# ============================================================

# Access token qisqa muddatli (daqiqa), refresh uzoq (kun).
ADMIN_ACCESS_TOKEN_MINUTES=30
ADMIN_REFRESH_TOKEN_DAYS=14

# Bot yuboradigan bir martalik kirish kodi (OTP) sozlamalari.
# IP bo'yicha limitlar kodda qattiq belgilangan (app/api/admin/auth.py:
# RATE_OTP_REQUEST va h.k.) — ular telegram_id limitidan mustaqil.
ADMIN_OTP_TTL_SECONDS=300
ADMIN_OTP_RESEND_SECONDS=60

# Faqat React dev-server uchun (npm run dev, http://localhost:5173).
# PROD'da BO'SH qoldiring — panel API bilan bir domenda (/admin) turadi
# va CORS umuman kerak bo'lmaydi.
# Vergul bilan ajrating: http://localhost:5173,http://127.0.0.1:5173
ADMIN_CORS_ORIGINS=

# ============================================================
# SaaS kvota
# ============================================================

# false — limitlar hisoblanadi, lekin skan RAD ETILMAYDI (yumshoq ishga tushirish).
# true  — limit tugagan ustoz varaq yubora olmaydi.
ENFORCE_QUOTA=false

# Yangi ro'yxatdan o'tgan ustozga beriladigan tarif kodi.
DEFAULT_PLAN_CODE=FREE

# Yangi obuna necha kun 'trial' bo'ladi (0 = darrov 'active').
TRIAL_DAYS=0
