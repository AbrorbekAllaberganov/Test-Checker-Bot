# ============================================================
# OMR Test Bot — Environment Variables
# Nusxa oling: cp .env.example .env
# Keyin BARCHA maydonlarni to'ldiring.
# ============================================================

# --- Telegram ---
BOT_TOKEN=8642853215:AAGsBfkRNFcgB0KW5Xzl3mwpuikfF7py_gQ
# Bot usernameni @ siz kiriting (base.html da ko'rsatiladi)
BOT_USERNAME=Test_Yordamchi_Robot

# Web Dashboard URL — bot ichidan menyuda "Dashboard" tugmasi paydo bo'ladi.
# HTTPS bo'lishi shart (Telegram Web App uchun). Bo'sh qoldirsa tugma ko'rinmaydi.
# Masalan: WEB_APP_URL=https://yourdomain.com/dashboard
WEB_APP_URL=

# --- PostgreSQL ---
# Docker compose ichida postgres container nomi
DATABASE_URL=postgresql+asyncpg://omruser:omrpass@postgres:5432/omrdb
SYNC_DATABASE_URL=postgresql+psycopg2://omruser:omrpass@postgres:5432/omrdb

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Admin ---
# Vergul bilan ajrating (bo'sh qoldirish mumkin)
ADMIN_TELEGRAM_IDS=

# --- FastAPI internal auth ---
INTERNAL_API_KEY=change-me-super-secret-internal-key

# --- Dashboard JWT autentifikatsiya ---
# MAJBURIY: admin panel (/admin) uchun tasodifiy 32+ belgilik kalit.
# Quyidagi namunaviy qiymat qoldirilsa admin panel ATAYLAB ishlamaydi
# (token berilmaydi) — chunki bu kalit ochiq repoda turadi va uni bilgan
# kishi o'ziga SUPERADMIN tokeni yasay oladi. Bot va Mini App bunga
# bog'liq emas, ular ishlashda davom etadi.
#
# Yarating:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-use-a-random-32-char-secret
# JWT cookie muddati (kunlarda)
JWT_EXPIRE_DAYS=7

# --- Fayllar ---
# Docker volume paths (compose'da mount qilinadi)
PDF_OUTPUT_DIR=/data/pdfs
DEBUG_OUTPUT_DIR=/data/debug
TEMP_DIR=/tmp/omr_uploads

# --- Rasm chegarasi ---
MAX_IMAGE_MB=20

# --- OMR sozlamalari ---
# true/false: debug annotatsiya rasmi saqlash
OMR_DEBUG=false
# Doira "to'ldirilgan" deb hisoblanishi uchun minimal fill ratio
FILL_MIN=0.35
# Ikkita eng ko'p to'ldirilgan doira orasidagi minimal farq (ambiguous uchun)
FILL_MARGIN=0.15
# OMR rasterizatsiya DPI (PDF -> image)
OMR_DPI=200
# Warp natijasi o'lchami px (A4 @ ~200 DPI)
WARP_W=1654
WARP_H=2339

# --- Postgres container sozlamalari (docker-compose uchun) ---
POSTGRES_USER=omruser
POSTGRES_PASSWORD=omrpass
POSTGRES_DB=omrdb

# --- Loki Log Server ---
LOKI_URL=http://loki:3100/loki/api/v1/push

# ============================================================
# Admin panel (React) — /admin
# ============================================================

# Access token qisqa muddatli (daqiqa), refresh uzoq (kun).
ADMIN_ACCESS_TOKEN_MINUTES=30
ADMIN_REFRESH_TOKEN_DAYS=14

# Bot yuboradigan bir martalik kirish kodi (OTP) sozlamalari.
ADMIN_OTP_TTL_SECONDS=300
ADMIN_OTP_RESEND_SECONDS=60

# Faqat React dev-server uchun (npm run dev, http://localhost:5173).
# PROD'da BO'SH qoldiring — panel API bilan bir domenda (/admin) turadi
# va CORS umuman kerak bo'lmaydi.
# Vergul bilan ajrating: http://localhost:5173,http://127.0.0.1:5173
ADMIN_CORS_ORIGINS=

# ============================================================
# SaaS kvota
# ============================================================

# false — limitlar hisoblanadi, lekin skan RAD ETILMAYDI (yumshoq ishga tushirish).
# true  — limit tugagan ustoz varaq yubora olmaydi.
ENFORCE_QUOTA=false

# Yangi ro'yxatdan o'tgan ustozga beriladigan tarif kodi.
DEFAULT_PLAN_CODE=FREE

# Yangi obuna necha kun 'trial' bo'ladi (0 = darrov 'active').
TRIAL_DAYS=0
