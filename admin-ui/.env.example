# Admin panel (Vite) environment
# Nusxa oling: cp .env.example .env.local

# Backend manzili. Bo'sh qoldirilsa so'rovlar nisbiy yo'l bilan ketadi
# ("/api/admin/...") — bu prod uchun to'g'ri, chunki panel FastAPI bilan
# bir domenda (/admin) xizmat qilinadi.
VITE_API_BASE_URL=

# Dev server proksi maqsadi (npm run dev paytida ishlatiladi).
VITE_API_PROXY_TARGET=http://localhost:8000
